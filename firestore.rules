rules_version = '2';

// Staff edit barangays/alerts and make admins in the Firebase console, which
// is not bound by these rules. tool/rules_test.mjs checks them on the emulator.
service cloud.firestore {
  match /databases/{database}/documents {
    // Accounts must click the emailed verification link before reading anything.
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      let profile = /databases/$(database)/documents/users/$(request.auth.uid);
      return signedIn() && exists(profile) && get(profile).data.get('role', '') == 'admin';
    }

    function text(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    match /barangays/{id} {
      allow read: if signedIn();
    }

    match /alerts/{id} {
      allow read: if signedIn();
    }

    // Nobody can give themselves a role.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Not signedIn(): the profile is written at sign-up, before verification
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'phone', 'createdAt'])
        && request.resource.data.uid == uid
        && text(request.resource.data.name, 100)
        && text(request.resource.data.phone, 20);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone']);
    }

    match /reports/{id} {
      allow read: if signedIn() && (resource.data.reporterUid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reporterUid', 'reporterName', 'reporterPhone', 'type',
                                                 'barangayName', 'details', 'status', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && text(request.resource.data.reporterName, 100)
        && (!('reporterPhone' in request.resource.data) || text(request.resource.data.reporterPhone, 20))
        && request.resource.data.type in ['flood', 'heat']
        && text(request.resource.data.barangayName, 100)
        && text(request.resource.data.details, 1000)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['pending', 'reviewing', 'resolved'];
    }

    // One conversation per resident, between them and the admins.
    match /chats/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && (request.auth.uid == uid || isAdmin())
        && request.resource.data.keys().hasOnly(['userName', 'userPhone', 'lastMessage', 'updatedAt'])
        && text(request.resource.data.lastMessage, 1000)
        && request.resource.data.updatedAt == request.time;

      match /messages/{id} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow create: if signedIn() && (request.auth.uid == uid || isAdmin())
          && request.resource.data.keys().hasOnly(['text', 'senderUid', 'fromAdmin', 'createdAt'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.fromAdmin == isAdmin()
          && text(request.resource.data.text, 1000)
          && request.resource.data.createdAt == request.time;
      }
    }
  }
}
